#!/usr/bin/env python3
"""Local, non-destructive Compose operator. Secrets are never printed."""
import argparse
import os
import secrets
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
os.chdir(ROOT)
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--mode', choices=['dev', 'prod'], default='prod')
p.add_argument('command', choices=['start','stop','restart','status','logs','update','doctor','seed','backup','restore','import-local','test'])
p.add_argument('args', nargs='*')
p.add_argument('--confirm-replace', action='store_true', help='Explicitly replace container database from a backup')
a = p.parse_args()
docker = shutil.which('docker') or '/Applications/Docker.app/Contents/Resources/bin/docker'
os.environ['PATH'] = str(Path(docker).parent) + os.pathsep + os.environ.get('PATH', '')
if not Path(docker).exists():
    sys.exit('Install Docker Desktop for Apple Silicon: https://docs.docker.com/desktop/setup/install/mac-install/ then launch it.')
try:
    engine_status = subprocess.run([docker, 'info'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20).returncode
except subprocess.TimeoutExpired:
    sys.exit('Docker Engine is not responding. Check free disk space and restart Docker Desktop, then retry.')
if engine_status:
    sys.exit('Docker Engine unavailable. Open Docker Desktop and wait for Engine running, then retry.')
runtime = ROOT / '.runtime'
runtime.mkdir(mode=0o700, exist_ok=True)
env_file = runtime / f'{a.mode}.env'
if not env_file.exists():
    fd = os.open(env_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(f'APP_TOKEN={secrets.token_hex(32)}\nPOSTGRES_PASSWORD={secrets.token_hex(24)}\nFIELDSHIFT_MODE={a.mode}\n')
cmd = [docker, 'compose', '--env-file', str(env_file), '-f', 'compose.yaml', '-f', f'compose.{a.mode}.yaml']
def run(*args, **kwargs):
    return subprocess.run([*cmd, *args], check=True, **kwargs)
def ready():
    for path in ['/', '/api/health', '/api/docs', '/earth', '/fields', '/satellites', '/climate', '/settings']:
        with urllib.request.urlopen('http://localhost:8080'+path, timeout=20) as r:
            if r.status != 200:
                raise RuntimeError(f'Route failed: {path}')
def backup():
    directory = ROOT / 'backups'
    directory.mkdir(mode=0o700, exist_ok=True)
    target = directory / f'fieldshift-{a.mode}-{time.time_ns()}.dump'
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'wb') as f:
            run('exec','-T','database','pg_dump','-U','fieldshift','-d','fieldshift','-Fc', stdout=f)
    except Exception:
        target.unlink(missing_ok=True)
        raise
    print(f'Backup saved: {target}')
    return target
try:
    if a.command in ['start','update']:
        if a.command == 'update':
            backup()
        marker = runtime / f'{a.mode}.database-acknowledged'
        if not marker.exists() and (ROOT / '.env').exists():
            print('NOTICE: Existing local .env detected. Docker uses a separate persistent database; the local database is untouched. Use ./fieldshift import-local to transfer it.')
            marker.touch(mode=0o600)
        run('up','-d','--build','--wait','--wait-timeout','240')
        ready()
        print('FieldShift ready: http://localhost:8080 (local-only). Demo data: ./fieldshift seed')
    elif a.command == 'stop':
        run('stop'); print('Stopped. Database volume retained.')
    elif a.command == 'restart':
        run('restart'); run('up','-d','--wait','--wait-timeout','240'); ready()
    elif a.command == 'status':
        run('ps','--all')
    elif a.command == 'logs':
        run('logs','--tail','150','-f',*a.args)
    elif a.command == 'seed':
        run('exec','-T','backend','python','-m','app.seed')
    elif a.command == 'backup':
        backup()
    elif a.command in ['restore','import-local']:
        if not a.confirm_replace or (a.command == 'restore' and not a.args):
            sys.exit('Restore replaces container records. Run backup first, then: ./fieldshift restore /absolute/file.dump --confirm-replace OR ./fieldshift import-local --confirm-replace')
        if a.command == 'import-local':
            pg_dump = shutil.which('pg_dump') or '/opt/homebrew/opt/postgresql@17/bin/pg_dump'
            target = runtime / 'local-import.dump'
            local_env = {}
            for line in (ROOT/'.env').read_text().splitlines():
                if '=' in line and not line.startswith('#'):
                    k,v=line.split('=',1);local_env[k]=v.strip().strip('"\'')
            url = local_env.get('DATABASE_URL','').replace('postgresql+psycopg://','postgresql://')
            if not url: sys.exit('No local DATABASE_URL found')
            from urllib.parse import urlsplit, unquote
            u=urlsplit(url)
            env=os.environ.copy()
            env.update(PGHOST=u.hostname or 'localhost',PGPORT=str(u.port or 5432),PGDATABASE=u.path.lstrip('/'),PGUSER=unquote(u.username) if u.username else os.environ.get('USER',''),PGPASSWORD=unquote(u.password) if u.password else '')
            fd=os.open(target,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
            with os.fdopen(fd,'wb') as f:
                subprocess.run([pg_dump,'-Fc'],env=env,stdout=f,check=True)
        else:
            target = Path(a.args[0]).resolve()
        if not target.is_file(): sys.exit('Backup file not found')
        backup()
        run('stop','frontend','backend')
        restore_list = '/tmp/fieldshift-restore-' + secrets.token_hex(8) + '.list'
        try:
            with target.open('rb') as f:
                toc = run('exec','-T','database','pg_restore','--list', stdin=f, capture_output=True).stdout.decode()
            # Official images preinstall dependent PostGIS extensions. Preserve their DDL;
            # dropping the base extension would fail, and CASCADE would destroy dependents.
            toc = '\n'.join(line for line in toc.splitlines() if ' EXTENSION ' not in line) + '\n'
            run('exec','-T','database','sh','-c', 'cat > ' + restore_list, input=toc.encode())
            with target.open('rb') as f:
                run('exec','-T','database','pg_restore','-U','fieldshift','-d','fieldshift','--clean','--if-exists','--no-owner','--no-acl','--single-transaction','--use-list',restore_list, stdin=f)
        finally:
            run('exec','-T','database','rm','-f',restore_list)
            run('up','-d','--wait')
        print('Restore complete. Original local database retained.')
    elif a.command == 'doctor':
        run('config','--quiet');run('ps','--all')
        run('exec','-T','database','psql','-U','fieldshift','-d','fieldshift','-c','SELECT PostGIS_Version();')
        ready(); print('Docker, PostGIS, API and all frontend routes healthy; port 8080 reachable.')
    elif a.command == 'test':
        run('build','backend')
        subprocess.run([docker,'build','--target','test','-f','backend/Dockerfile','-t',f'fieldshift-test-{a.mode}','.'],check=True)
        run('exec','-T','database','sh','-c', "psql -U fieldshift -d postgres -tc \"SELECT 1 FROM pg_database WHERE datname='fieldshift_test'\" | grep -q 1 || createdb -U fieldshift fieldshift_test")
        override = runtime / 'test.yaml'
        override.write_text(f'services:\n  backend:\n    image: fieldshift-test-{a.mode}\n')
        subprocess.run([*cmd,'-f',str(override),'run','--rm','--no-deps','backend','sh','-c', 'export DATABASE_URL="${DATABASE_URL%/fieldshift}/fieldshift_test"; alembic upgrade head && python -m app.seed && pytest -q -o cache_dir=/tmp/fieldshift-pytest-cache'],check=True)
        ready()

except (subprocess.CalledProcessError, OSError, RuntimeError) as exc:
    print(f'Operation failed: {exc}. Inspect ./fieldshift status and ./fieldshift logs. Data volumes are retained.',file=sys.stderr)
    sys.exit(1)
