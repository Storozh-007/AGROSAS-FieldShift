DATABASE_URL=postgresql+psycopg://localhost:5432/fieldshift
# Local single-organization demonstration. Generate a random token for both services.
APP_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional research integrations; not required for the first working scenario.
EARTHDATA_TOKEN=
OPENAI_API_KEY=
# Compose uses independently generated .runtime/dev.env and .runtime/prod.env.
# Do not copy local database credentials into Docker images.
# FIELDSHIFT_MODE=prod
# POSTGRES_PASSWORD=<generated by ./fieldshift>
